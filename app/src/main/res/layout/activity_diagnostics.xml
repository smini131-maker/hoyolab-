<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="진단 정보"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosticsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:text="예약 상태를 확인하는 중입니다."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button android:id="@+id/refreshDiagnosticsButton" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:text="새로고침" />
        <Button android:id="@+id/closeDiagnosticsButton" style="@style/SecondaryButton" android:layout_marginTop="8dp" android:text="닫기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="보안을 위해 쿠키, 토큰, 계정 ID, 이메일, 전화번호는 표시하지 않습니다."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
